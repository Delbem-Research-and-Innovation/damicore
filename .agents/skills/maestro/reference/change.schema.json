{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TriangulosTecnologia/devanity-skills/blob/main/skills/maestro/reference/change.schema.json",
  "title": "Devanity Open Change",
  "type": "object",
  "required": ["id", "state", "intent", "scope", "requirements", "decisions", "impact", "authority", "verification", "execution", "evidence", "findings", "residual_risk", "completion"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "state": {
      "enum": ["NEW", "FRAMING", "INSPECTING", "NEEDS_DECISION", "READY", "EXECUTING", "VERIFYING", "ASSURING", "CANDIDATE_READY", "NO_CHANGE", "BLOCKED", "NOT_VERIFIED", "INVALID_TARGET"]
    },
    "target": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "ref": { "type": "string" },
        "base": { "type": "string" },
        "head": { "type": "string" },
        "fingerprint": { "type": "string" }
      },
      "additionalProperties": true
    },
    "intent": {
      "type": "object",
      "required": ["problem", "desired_outcome"],
      "properties": {
        "problem": { "type": "string" },
        "current_state": { "type": "string" },
        "desired_outcome": { "type": "string" }
      },
      "additionalProperties": true
    },
    "scope": {
      "type": "object",
      "required": ["included", "excluded", "non_goals"],
      "properties": {
        "included": { "type": "array", "items": { "type": "string" } },
        "excluded": { "type": "array", "items": { "type": "string" } },
        "non_goals": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "claim", "acceptance"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "claim": { "type": "string" },
          "acceptance": { "type": "string" },
          "criticality": { "enum": ["low", "medium", "high", "critical"] }
        },
        "additionalProperties": true
      }
    },
    "decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/decision" }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "blocking"],
        "properties": {
          "question": { "type": "string" },
          "blocking": { "type": "boolean" },
          "owner": { "type": "string" },
          "impact": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "impact": {
      "type": "object",
      "required": ["architecture_class", "risk_class", "affected_surfaces"],
      "properties": {
        "architecture_class": { "enum": ["A0", "A1", "A2", "unknown"] },
        "risk_class": { "enum": ["normal", "high", "unknown"] },
        "origin": { "enum": ["trusted-local", "external", "unknown"] },
        "affected_surfaces": { "type": "array", "items": { "type": "string" } },
        "expected_delta": { "type": "array", "items": { "type": "string" } },
        "forbidden_delta": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "architecture": {
      "type": "object",
      "properties": {
        "constraints": { "type": "array", "items": { "type": "string" } },
        "decisions": { "type": "array", "items": { "type": "string" } },
        "repository_topology": { "type": "array", "items": { "type": "string" } },
        "status": { "enum": ["not-required", "conforming", "resolved", "needs-decision", "incomplete"] }
      },
      "additionalProperties": true
    },
    "authority": {
      "type": "object",
      "required": ["ceiling"],
      "properties": {
        "ceiling": { "enum": ["observe", "recommend", "prepare", "execute", "commit", "merge", "deploy"] },
        "granted_by": { "type": "string" },
        "basis": { "type": "string" },
        "constraints": { "type": "array", "items": { "type": "string" } },
        "expires_at": { "type": "string" }
      },
      "additionalProperties": true
    },
    "verification": {
      "type": "object",
      "required": ["obligations"],
      "properties": {
        "obligations": {
          "type": "array",
          "items": { "$ref": "#/$defs/proofObligation" }
        },
        "independent_required": { "type": "boolean" },
        "independent_result": { "enum": ["pending", "VERIFIED", "FAILED", "NOT VERIFIED", "INVALID TARGET"] },
        "verified_target_fingerprint": { "type": "string" }
      },
      "additionalProperties": true
    },
    "execution": {
      "type": "object",
      "required": ["slices"],
      "properties": {
        "slices": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "depends_on", "expected_files", "status"],
            "properties": {
              "id": { "type": "string" },
              "depends_on": { "type": "array", "items": { "type": "string" } },
              "expected_files": { "type": "array", "items": { "type": "string" } },
              "expected_delta": { "type": "array", "items": { "type": "string" } },
              "forbidden_delta": { "type": "array", "items": { "type": "string" } },
              "proof_obligations": { "type": "array", "items": { "type": "string" } },
              "required_authority": { "enum": ["observe", "recommend", "prepare", "execute", "commit", "merge", "deploy"] },
              "status": { "enum": ["pending", "active", "verified", "failed", "blocked"] }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "residual_risk": {
      "type": "array",
      "items": { "type": "string" }
    },
    "completion": {
      "type": "object",
      "required": ["state", "rationale"],
      "properties": {
        "state": { "enum": ["pending", "candidate-ready", "no-change", "blocked", "not-verified", "invalid-target"] },
        "rationale": { "type": "string" },
        "next_action": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["id", "type", "source", "target", "observed_at", "claim", "result"],
      "properties": {
        "id": { "type": "string" },
        "type": { "enum": ["read", "command", "diff", "check", "human-confirmation", "external-reference"] },
        "source": { "type": "string" },
        "target": { "type": "string" },
        "target_fingerprint": { "type": "string" },
        "observed_at": { "type": "string" },
        "claim": { "type": "string" },
        "result": {}
      },
      "additionalProperties": true
    },
    "decision": {
      "type": "object",
      "required": ["id", "question", "options", "authority", "status"],
      "properties": {
        "id": { "type": "string" },
        "question": { "type": "string" },
        "context": { "type": "string" },
        "options": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "recommendation": { "type": "string" },
        "authority": { "type": "string" },
        "status": { "enum": ["pending", "resolved", "rejected", "expired"] },
        "resolution": { "type": "string" },
        "blocks": { "type": "array", "items": { "type": "string" } },
        "durability": { "enum": ["one-off", "reusable", "unknown"] }
      },
      "additionalProperties": true
    },
    "finding": {
      "type": "object",
      "required": ["id", "source", "statement", "disposition"],
      "properties": {
        "id": { "type": "string" },
        "source": { "type": "string" },
        "statement": { "type": "string" },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "severity": { "type": "string" },
        "disposition": { "enum": ["open", "fixed", "accepted", "rejected", "deferred"] },
        "owner": { "type": "string" }
      },
      "additionalProperties": true
    },
    "proofObligation": {
      "type": "object",
      "required": ["requirement_id", "failure_mode", "observable", "oracle", "method", "evidence_required", "status"],
      "properties": {
        "requirement_id": { "type": "string" },
        "failure_mode": { "type": "string" },
        "observable": { "type": "string" },
        "oracle": { "type": "string" },
        "method": { "type": "string" },
        "evidence_required": { "type": "array", "items": { "type": "string" } },
        "status": { "enum": ["pending", "satisfied", "failed", "not-verifiable"] }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
