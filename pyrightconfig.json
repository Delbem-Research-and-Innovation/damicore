  "reportPrivateUsage": false,
  "pythonVersion": "3.11",
  "typeCheckingMode": "strict",
  "stubPath": "stubs",
  "venvPath": ".",
  "venv": ".venv",
  "extraPaths": [
    "packages/damicore/src",
    "packages/damicore_normalizer/src",
    "packages/damicore_distance/src",
    "packages/damicore_tree_builder/src",
    "packages/damicore_clusterizer/src",
    "packages/synthetic_data/src"
  ]
}
